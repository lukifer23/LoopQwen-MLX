    "id": "ledger-curriculum-01",
    "seed": 19260317,
    "question": "Can direct supervision on short, densely populated keyed ledgers teach the deployed arithmetic adapter to find unseen random values among comparable distractors at 2K and 16K, while retaining its arithmetic and prose?",
    "parent": "research/sessions/2026-11-25/gsm-rationale-01/model",
    "parent_sha256": "6bfea67555caa9c04839a6c502b98b6dbd62093c3a2390c91538a0bc8fff733f",
    "dense_control": "research/results/rationale-dense-01/model",
    "dense_sha256": "54c4a33a8b44e72c9a05cb2422ae68e7a3ad510fadd42192bbb62dfe7dda0d1a",
    "depth": 2,
